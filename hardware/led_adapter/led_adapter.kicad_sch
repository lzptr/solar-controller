	)
	(text "Pin pairs: 1-2 data (DIN / DOUT), 3-4 GND, 5-6 +5V. 5V and GND are bussed straight through; data enters the ring at IN and leaves at OUT."
		(exclude_from_sim no)
		(at 76.2 132.08 0)
		(effects
