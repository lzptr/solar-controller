	(text "USB-C power: fixed 5 V / 3 A source"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "076d3610-515a-48b6-b852-9d6a981e53c6")
	)
	(text "LED Data"
		(exclude_from_sim no)
		(at 112.268 109.474 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "2e4bb2f3-d399-427a-8660-8ea9910a633f")
	)
	(text "R403: 1k, 1% (Basic), ILIM = 2.04 A nominal.\nAllow for limit tolerance: firmware LED budget = 1.8 A.\nC403: 100n, SR = 0.42 V/ms, about 12 ms to 5 V.\nC404 + C405 = 492u, capacitive inrush about 0.21 A.\nTI specifies 3.3n minimum and larger CdVdt for large COUT.\nUse TI SLVSE57C, sections 7.3, 8.3.3.1 and 9.2.2.3.\nEN follows LED_PWR_EN via R406; R407 holds EN low at reset.\nOFF = LED_PWR_EN low: the eFuse cuts the 5 V LED rail.\nFLT_N reports thermal shutdown, not a power-good signal."
		(exclude_from_sim no)
		(at 23.114 82.296 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "37070fba-4604-4856-985f-d9d391781d9c")
	)
	(text "LED Power"
		(exclude_from_sim no)
		(at 24.384 32.512 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "3909cd12-f8f4-4696-a010-c8f914446d1d")
	)
	(text "J401: 1 = switched +5V, 2 = DATA, 3 = GND.\nU403: DIR high selects A -> B. VCC isolation + Ioff\nprevent DATA from powering an unpowered LED chain.\nFit C406 / C407 close to the two supply pins."
		(exclude_from_sim no)
		(at 113.03 156.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7422c475-ffe1-4c87-b6a8-e501cb375004")
	)
	(text "Turn / Press Control"
		(exclude_from_sim no)
		(at 23.114 109.474 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "bf47941f-50bc-42a1-a848-3fc3ab15ed80")
	)
	(text "Debounce A/B and the push button in firmware.\nA = GPIO19, B = GPIO20, push = GPIO21 (active low)."
		(exclude_from_sim no)
		(at 23.114 160.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fce9cb83-7b9b-4a07-b7cc-85a8fd3b227c")
	)
